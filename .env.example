# 이 파일은 키 이름만 담는다. 실제 값은 .env.local(로컬, git 제외)과 Vercel 환경 변수에만 넣는다.
# 비밀값 만들기: npm run secrets

# 기본
APP_BASE_URL=http://localhost:3000
APP_TIMEZONE=Asia/Seoul

# 로그인 (GitHub OAuth App, D-06)
SESSION_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ALLOWED_GITHUB_USER_ID=

# DB (Supabase, D-09)
DATABASE_URL=
DIRECT_DATABASE_URL=
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_VERSION=1

# 작업 스케줄 (Supabase Cron → /api/jobs/tick)
CRON_SECRET=
JOB_TIME_BUDGET_SECONDS=240

# Google Calendar (Apps Script 브리지, D-11)
GAS_CALENDAR_WEBAPP_URL=
GAS_CALENDAR_SHARED_SECRET=

# Notion (Internal connection, D-04)
NOTION_INTERNAL_TOKEN=
NOTION_API_VERSION=2026-03-11
NOTION_MEETING_ROOT_PAGE_ID=39dfa7ab-52b6-80c9-9e08-db79b4afe378
NOTION_MAX_DEPTH=2

# NAVER WORKS (mail.read)
NAVERWORKS_CLIENT_ID=
NAVERWORKS_CLIENT_SECRET=
NAVERWORKS_SCOPES=mail.read
NAVERWORKS_DOMAIN=

# 운영
MAIL_RETENTION_DAYS=90
LOG_LEVEL=info
